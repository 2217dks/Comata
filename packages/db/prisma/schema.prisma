// Prisma 7 (stable): ESM-first `prisma-client` generator (output path required),
// Rust-free client — driver adapters are the standard runtime setup.
//
// Deviations from docs/data-model.md (deliberate):
//   * User.id / ownerId / member userId are plain strings — Better-Auth issues
//     its own ids (not UUIDs).
//   * CodeRun was removed (ADR-0003): runs are per-user and ephemeral — results
//     go only to the requesting client and are never persisted. Concurrency is
//     guarded by an in-memory per-user run lock + rate limit in apps/api.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URLs live in prisma.config.ts (CLI) and the pg
  // adapter (runtime client) — never in the schema.
}

// ── Auth (Better-Auth Prisma adapter owns these — do not hand-edit fields) ──

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  accounts      Account[]
  sessions      Session[]
  notebooks     Notebook[]       @relation("NotebookOwner")
  members       NotebookMember[]
  generations   GeneratedElement[]
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ── Domain ──────────────────────────────────────────────────────────────────

/// The project container. All app work happens inside a notebook.
/// Elements (text, ink, shapes, code, math, visualizers, images, frames)
/// live ONLY in the Yjs doc — snapshotted into `yjsSnapshot` per R1.
model Notebook {
  id              String             @id @default(uuid()) @db.Uuid
  title           String
  kind            NotebookKind       @default(canvas)
  /// Canvas notebooks: surface tone, fixed at creation (Slice 7). Presentation
  /// notebooks don't use it — pages carry per-page colors in the doc.
  background      NotebookBackground @default(dark)
  ownerId         String
  owner           User               @relation("NotebookOwner", fields: [ownerId], references: [id])
  yjsSnapshot     Bytes?
  thumbnailUrl    String?
  schemaVersion   Int                @default(1)
  /// Owner-controlled (ADR-0003): whether VIEWERs may run code. Default off.
  allowViewerRuns Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  members         NotebookMember[]

  @@index([ownerId, updatedAt])
}

enum NotebookKind {
  canvas
  presentation
}

enum NotebookBackground {
  light
  dark
}

model NotebookMember {
  notebookId String     @db.Uuid
  userId     String
  role       MemberRole
  notebook   Notebook   @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notebookId, userId])
  @@index([userId])
}

enum MemberRole {
  OWNER
  EDITOR
  VIEWER
}

// ── AI generation (Slice 5b, ADR-0004) ──────────────────────────────────────

/// Deny-by-default gate for POST /v1/generate: only listed emails may
/// generate. The owner manages this live (admin page) during demos.
model AiAllowlist {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  /// Who granted access (owner's User.id); "" for seeded rows.
  grantedBy String   @default("")
  createdAt DateTime @default(now())
}

/// Account-level library of every generation a user performed (immutable
/// rows — regenerate/edit-prompt append, never update). Board elements keep
/// `libraryId` to point back; deleting a board element never touches this.
model GeneratedElement {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  prompt      String
  description String   @default("")
  /// Single self-contained HTML file (inline CSS+JS, no network) — size-capped
  /// at insert (~200KB) and served back as iframe srcdoc.
  html        String
  specVersion Int      @default(1)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}
